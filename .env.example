# ============================================================
#  ASERTI STORE — environment configuration
#  Copy this file to ".env" and fill in real values.
#  Leave payment/shipping credentials empty to run in SANDBOX mode.
# ============================================================

# ---- App ----
# Public base URL of the site (used to build payment callback/return URLs).
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
# Store display currency (ISO 4217). ASERTI prices are in Georgian Lari.
NEXT_PUBLIC_CURRENCY="GEL"

# ---- Database (Postgres) ----
# Get these from Neon / Supabase / Vercel Postgres. If your provider gives a
# single URL, set DIRECT_URL to the same value. See DEPLOY_VERCEL.md.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/aserti?schema=public&sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/aserti?schema=public&sslmode=require"

# ---- Payment mode ----
# "sandbox"  -> no real bank calls; a local mock payment page simulates success/failure.
# "live"     -> use the real TBC / BOG APIs with the credentials below.
PAYMENTS_MODE="sandbox"

# ---- Admin login ----
# Credentials for the /admin orders dashboard.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-strong-password"
# Secret used to sign the admin session cookie. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=""

# ---- Email (order confirmations) ----
# Leave SMTP_HOST empty to run without sending (messages are logged to console).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ASERTI STORE <no-reply@aserti.store>"
# Optional: BCC every order confirmation to the store owner.
STORE_NOTIFICATION_EMAIL=""

# ============================================================
#  TBC BANK — E-Commerce (TPAY) API
#  Get these from TBC merchant onboarding / developer portal.
# ============================================================
TBC_API_BASE="https://api.tbcbank.ge"
TBC_CLIENT_ID=""
TBC_CLIENT_SECRET=""
TBC_APIKEY=""
# Merchant identifier issued by TBC.
TBC_MERCHANT_ID=""

# ============================================================
#  BANK OF GEORGIA — E-Commerce API (iPay)
#  Get these from BOG merchant onboarding.
# ============================================================
BOG_API_BASE="https://api.bog.ge"
BOG_CLIENT_ID=""
BOG_CLIENT_SECRET=""
# Public key BOG uses to sign callbacks (optional, for signature verification).
BOG_CALLBACK_PUBLIC_KEY=""

# ============================================================
#  QUICKSHIPPER — shipping / courier integration
#  Get these from your Quickshipper account.
# ============================================================
QUICKSHIPPER_API_BASE="https://api.quickshipper.ge"
QUICKSHIPPER_API_KEY=""
QUICKSHIPPER_SECRET=""
# Default pickup / sender info used when creating shipments.
QUICKSHIPPER_SENDER_NAME="ASERTI STORE"
QUICKSHIPPER_SENDER_PHONE=""
QUICKSHIPPER_SENDER_CITY="Tbilisi"
QUICKSHIPPER_SENDER_ADDRESS=""
