# ============================================================
#  ASERTI STORE — PRODUCTION environment (example)
#  Copy to your host's environment settings (Vercel/VPS/etc.).
#  NEVER commit real secrets.
# ============================================================

NEXT_PUBLIC_BASE_URL="https://your-domain.ge"
NEXT_PUBLIC_CURRENCY="GEL"

# ---- Database: Postgres ----
# First set  provider = "postgresql"  in prisma/schema.prisma (see DEPLOYMENT.md).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/aserti?schema=public&sslmode=require"
# When using a connection pooler (e.g. Supabase/Neon PgBouncer), set the pooled
# URL above and the direct URL here for migrations:
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/aserti?schema=public&sslmode=require"

# ---- Payments ----
PAYMENTS_MODE="live"

FLITT_API_BASE="https://pay.flitt.com"
FLITT_MERCHANT_ID="..."
FLITT_SECRET_KEY="..."

BOG_API_BASE="https://api.bog.ge"
BOG_CLIENT_ID="..."
BOG_CLIENT_SECRET="..."
BOG_CALLBACK_PUBLIC_KEY=""

# ---- Shipping ----
QUICKSHIPPER_API_BASE="https://api.quickshipper.ge"
QUICKSHIPPER_API_KEY="..."
QUICKSHIPPER_SECRET="..."
QUICKSHIPPER_SENDER_NAME="ASERTI STORE"
QUICKSHIPPER_SENDER_PHONE="..."
QUICKSHIPPER_SENDER_CITY="Tbilisi"
QUICKSHIPPER_SENDER_ADDRESS="..."

# ---- Admin ----
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="a-strong-unique-password"
ADMIN_SESSION_SECRET="a-64-char-random-hex-string"

# ---- Email ----
SMTP_HOST="smtp.yourprovider.com"
SMTP_PORT="587"
SMTP_USER="..."
SMTP_PASS="..."
SMTP_FROM="ASERTI STORE <orders@your-domain.ge>"
STORE_NOTIFICATION_EMAIL="orders@your-domain.ge"
